country:capital a rdf:Property ;
    rdfs:label "Ibu kota"^^xsd:string ;
    rdfs:domain country:Country ;
    rdfs:range xsd:string .

country:countryCode a rdf:Property ;
    rdfs:label "Kode negara"^^xsd:string ;
    rdfs:domain country:Country ;
    rdfs:range xsd:string .

country:countryName a rdf:Property ;
    rdfs:label "Nama negara"^^xsd:string ;
    rdfs:domain country:Country ;
    rdfs:range xsd:string .

country:currencyCode a rdf:Property ;
    rdfs:label "Kode mata uang"^^xsd:string ;
    rdfs:domain country:Currency ;
    rdfs:range xsd:string .

country:currencyName a rdf:Property ;
    rdfs:label "Nama mata uang"^^xsd:string ;
    rdfs:domain country:Currency ;
    rdfs:range xsd:string .

country:hasLanguage a rdf:Property ;
    rdfs:label "Memiliki bahasa"^^xsd:string ;
    rdfs:domain country:Country ;
    rdfs:range country:Language .

country:languageName a rdf:Property ;
    rdfs:label "Nama bahasa"^^xsd:string ;
    rdfs:domain country:Language ;
    rdfs:range xsd:string .

country:locatedInRegion a rdf:Property ;
    rdfs:label "Berada di region"^^xsd:string ;
    rdfs:domain country:Country ;
    rdfs:range country:Region .

country:officialName a rdf:Property ;
    rdfs:label "Nama resmi negara"^^xsd:string ;
    rdfs:domain country:Country ;
    rdfs:range xsd:string .

country:population a rdf:Property ;
    rdfs:label "Populasi"^^xsd:string ;
    rdfs:domain country:Country ;
    rdfs:range xsd:integer .

country:regionName a rdf:Property ;
    rdfs:label "Nama region"^^xsd:string ;
    rdfs:domain country:Region ;
    rdfs:range xsd:string .

country:usesCurrency a rdf:Property ;
    rdfs:label "Menggunakan mata uang"^^xsd:string ;
    rdfs:domain country:Country ;
    rdfs:range country:Currency .

